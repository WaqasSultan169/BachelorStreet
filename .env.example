# ------------------------------------------------------------------
# Bachelor Street Café — environment variables
# Copy to .env.local and fill in real values. NEVER commit real secrets.
# ------------------------------------------------------------------

# --- App -----------------------------------------------------------------
# Public origin of the app (used for redirects, links, absolute email URLs).
APP_URL=http://localhost:3000
# Client-side mirror of the origin (must stay publicly inlineable).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- MongoDB Atlas --------------------------------------------------------
# Connection string to Atlas; use a least-privilege user + IP allow-list.
# The app fails fast at first DB access if this is missing.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bachelor-street?retryWrites=true&w=majority

# --- Auth.js ---------------------------------------------------------------
# High-entropy secret that signs session JWTs. Generate with:
#   openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Rotate in production to invalidate sessions.
AUTH_SECRET=generate-a-32-byte-random-secret

# Google OAuth (create at https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Canonical base URL used by Auth.js callbacks. APP_URL is the default; set
# this only when Auth.js must use a different origin (rare).
# AUTH_URL=http://localhost:3000

# Trust platform host header (set true behind reverse proxies with APP_URL).
# AUTH_TRUST_HOST=true

# --- SMTP (transactional email) --------------------------------------------
# Leave blank to disable sending (login/register still work; email service
# logs "email disabled" instead of failing).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Bachelor Street Café <no-reply@bachelorstreet.example>"
# Optional SMS/WhatsApp provider adapter: must accept a JSON {to,message}
# request and return 2xx. Phone notifications require explicit user opt-in.
PHONE_NOTIFICATION_WEBHOOK_URL=
PHONE_NOTIFICATION_WEBHOOK_TOKEN=

# --- Realtime (Socket.IO) ----------------------------------------------------
# Where the browser connects for live order updates. Blank = same origin as APP_URL.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# Dedicated deployable Socket.IO process. Use the same ticket/internal secrets
# in both the Next.js and Socket.IO services; never expose these to the browser.
SOCKET_PORT=3001
SOCKET_ALLOWED_ORIGINS=http://localhost:3000
SOCKET_SERVER_INTERNAL_URL=http://localhost:3001
SOCKET_INTERNAL_SECRET=replace-with-a-32-character-random-secret
SOCKET_TICKET_SECRET=replace-with-a-different-32-character-random-secret
# Optional Redis URL enables the Socket.IO Redis adapter across instances.
# REDIS_URL=redis://localhost:6379

# --- Delivery zones ----------------------------------------------------------
# Straight-line radius (km) around the delivery origin. Enforced server-side;
# the client only ever displays it. Defaults to 5 km when unset.
DELIVERY_RADIUS_KM=5

# --- Geocoding (address search) ---------------------------------------------
# Provider: "demo" (default), "mapbox" or "google". With no key — or provider
# "demo" — the app uses a clearly-labelled SAMPLE lookup, never real geocoding.
# Keys are read SERVER-SIDE ONLY (src/server/services/geo.service.ts) and are
# never exposed to the browser. Restrict keys to the geocoding API and lock
# them to your server IP where the provider supports it.
GEOCODING_PROVIDER=demo
GEOCODING_API_KEY=

# --- Demo / seeds ------------------------------------------------------------
# Optional: upsert a demo admin when running `npm run seed` (password is set
# through your normal auth flow; no password is stored by the seed).
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME="Demo Admin"

# Non-destructive demo data (customers, riders, orders, hero slides). Nothing
# runs at startup, build or deploy time — you invoke it explicitly:
#   PowerShell:  $env:DEMO_SEED_ENABLED="true"; npm run seed:demo
#   bash:        DEMO_SEED_ENABLED=true npm run seed:demo
#   dry run:     append `-- --dry-run` (reports what would change, writes nothing)
# Guards (all are refused loudly, never silently skipped):
#   * NODE_ENV/VERCEL_ENV must not be "production" — demo data is never written
#     to production.
#   * DEMO_SEED_ENABLED must be exactly "true".
#   * A non-local Mongo host additionally requires DEMO_SEED_ALLOW_REMOTE=true.
# It is idempotent (re-running never duplicates rows) and never deletes or
# overwrites records without the `isDemo` marker, so real admin data is safe.

# --- Cloudinary (product & offer imagery) -----------------------------------
# Used by `npm run images:upload` to copy the photos in scripts/seed-images.json
# into your Cloudinary account, by the storefront to build optimized image
# URLs (f_auto/q_auto) from those public ids, and by the admin hero-slider
# "Upload image" option (src/server/services/upload.service.ts).
#
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME is intentionally public — it only builds
# read URLs. API key/secret are used by the upload script and MUST stay private.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder prefix for hero-slider uploads. Defaults to "bachelor-street/hero".
# CLOUDINARY_HERO_FOLDER=bachelor-street/hero

# --- Reserved / not yet wired ------------------------------------------------
# These are documented for forward planning but NO code reads them today, so
# setting them has no effect. Wire a provider before relying on them.
#
# Online payments (the `online` payment method is intentionally unavailable —
# see src/lib/constants.ts PAYMENT_METHODS and src/server/services/payment/).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
#
# SMS/WhatsApp notifications (use SMTP for now; email is the only verified
# channel — see src/server/services/notifications/).
# SMS_PROVIDER=
# SMS_API_KEY=
# SMS_SENDER_ID=